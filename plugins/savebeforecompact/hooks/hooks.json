{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_resume.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_resume.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/context_watch.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/context_watch.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
